+test('separation retains customer worker and TLS keys on the host filesystem', () => {
+  const root = workspace();
+  for (const name of ['worker/signing-key.pem', 'tls/server-key.pem']) {
+    mkdirSync(join(root, '.local/profiles/acme', name.split('/')[0]!), { recursive: true });
+    writeFileSync(join(root, '.local/profiles/acme', name), '-----BEGIN PRIVATE KEY-----synthetic-customer-key');
+  }
+  assert.deepEqual(separate().trusted, ['acme']);
+  mkdirSync(join(root, '.local/profiles/acme/nested/worker'), { recursive: true });
+  writeFileSync(join(root, '.local/profiles/acme/nested/worker/signing-key.pem'), '-----BEGIN PRIVATE KEY-----unexpected');
+  assert.throws(() => separate(), /Private key material found under customer profiles/);
+});
