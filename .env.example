# Safe example only. Run profile-init to generate local credentials; no defaults.
ORVIA_PROFILE=codex-a00
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
BETTER_AUTH_TELEMETRY=0
# Services bind only to loopback. A00 transport is development-only HTTP/TCP.
# Verified application TLS and full authentication are later gated obligations.
