[Unit]
Description=ORVIA application (@PROFILE@)
Requires=orvia-services.service
After=orvia-services.service

[Service]
User=@USER@
WorkingDirectory=@ROOT@
Environment=ORVIA_PROFILE=@PROFILE@ ORVIA_WORKSPACE_ROOT=@ROOT@ NEXT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 BETTER_AUTH_TELEMETRY=0
# Machine logins are renewed first so a boot after a long outage starts with valid enrollments.
ExecStartPre=-/usr/bin/env bash -c '@RENEW_EXEC@'
ExecStart=/usr/bin/env bash -c '@APP_EXEC@'
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
