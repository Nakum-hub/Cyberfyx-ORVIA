[Unit]
Description=ORVIA local backup with restore verification (@PROFILE@); the backup stays on this host
After=orvia-services.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
Environment=ORVIA_PROFILE=@PROFILE@ ORVIA_WORKSPACE_ROOT=@ROOT@
ExecStart=/usr/bin/env bash -c '@BACKUP_EXEC@'
