{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "types": ["node"], "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/.next", ".local", "**/dist"]
}
